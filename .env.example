PROJECT_NAME = Hoteler
VERSION = v.1.0.0
DEBUG = True
CORS_ALLOWED_ORIGINS = http://127.0.0.1:8000
API_PREFIX = /v1
# Для локальной разработки можно использовать SQLite:
# DATABASE_URL = sqlite:///./db.sqlite3
# Для production и основного использования — PostgreSQL:
DATABASE_URL = postgresql+psycopg2://postgres:postgres@localhost:5432/hotel
URL_TEST_USER = http://127.0.0.1:8000/v1/users
